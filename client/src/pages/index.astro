---
// src/pages/index.astro
import DashboardLayout from '../layouts/DashboardLayout.astro';
import TaskStats from '../components/TaskStats.astro';
import TaskFilters from '../components/TaskFilters.astro';
import TaskCard from '../components/TaskCard.astro';

const tasks = [
  {
    title: 'Refonte du dashboard principal',
    description: 'Mise à jour de l\'interface avec les nouveaux composants glassmorphiques',
    priority: 'high',
    dueDate: '15/03/2024',
    assignedTo: 'Marie C.',
    tags: ['design', 'frontend']
  },
  {
    title: 'Intégration API GraphQL',
    description: 'Connecter le backend avec les nouvelles requêtes optimisées',
    priority: 'high',
    dueDate: '12/03/2024',
    assignedTo: 'Thomas L.',
    tags: ['backend', 'api']
  },
  {
    title: 'Tests utilisateurs',
    description: 'Organiser des sessions de test avec les bêta-testeurs',
    priority: 'medium',
    dueDate: '20/03/2024',
    assignedTo: 'Sophie M.',
    tags: ['ux', 'research']
  },
  {
    title: 'Documentation technique',
    description: 'Rédiger la documentation pour les développeurs',
    priority: 'low',
    dueDate: '25/03/2024',
    assignedTo: 'Alex D.',
    tags: ['docs']
  },
  {
    title: 'Optimisation des performances',
    description: 'Améliorer le temps de chargement des composants',
    priority: 'high',
    dueDate: '10/03/2024',
    assignedTo: 'Pierre F.',
    tags: ['performance']
  },
  {
    title: 'Mise à jour des dépendances',
    description: 'Mettre à jour les packages vers leurs dernières versions',
    priority: 'medium',
    dueDate: '18/03/2024',
    assignedTo: 'Julie R.',
    tags: ['maintenance']
  },
];
---

<DashboardLayout>
  <!-- Section des statistiques -->
  <TaskStats />

  <!-- Filtres -->
  <TaskFilters />

  <!-- En-tête de la section tâches -->
  <div class="mb-6 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
    <div>
      <h2 class="text-2xl font-bold text-white flex items-center gap-2">
        <i class="fa-solid fa-list-check text-purple-400"></i>
        Tâches récentes
      </h2>
      <p class="text-white/60 text-sm mt-1">Vous avez 12 tâches au total</p>
    </div>
    <a href="./login">Login</a>
	<a href="./dashboard">Dashboard</a>
    <!-- Bouton nouvelle tâche avec animation -->
    <button class="group relative px-6 py-3 bg-gradient-to-r from-blue-500 to-purple-600 rounded-xl text-white font-medium hover:shadow-2xl hover:scale-105 transition-all duration-300 overflow-hidden">
      <span class="absolute inset-0 bg-white/20 translate-y-full group-hover:translate-y-0 transition-transform duration-300"></span>
      <span class="relative flex items-center gap-2">
        <i class="fa-solid fa-plus"></i>
        Nouvelle tâche
      </span>
    </button>
  </div>

  <!-- Grille des tâches -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    {tasks.map((task) => (
      <TaskCard
        title={task.title}
        description={task.description}
        priority={task.priority}
        dueDate={task.dueDate}
        assignedTo={task.assignedTo}
        tags={task.tags}
      />
    ))}
  </div>

  <!-- Section analytiques -->
  <div class="mt-8 grid grid-cols-1 lg:grid-cols-3 gap-6">
    <!-- Graphique d'activité -->
    <div class="lg:col-span-2 bg-gradient-to-br from-purple-900/30 to-blue-900/30 backdrop-blur-xl rounded-3xl border border-white/20 p-6">
      <div class="flex items-center justify-between mb-6">
        <h3 class="text-white font-semibold flex items-center gap-2">
          <i class="fa-solid fa-chart-line text-purple-400"></i>
          Activité hebdomadaire
        </h3>
        <select class="bg-white/10 border border-white/20 rounded-xl px-3 py-1 text-white/80 text-sm">
          <option>Cette semaine</option>
          <option>Ce mois</option>
          <option>Cette année</option>
        </select>
      </div>
      
      <div class="h-64 flex items-end gap-3">
        {[
          { day: 'Lun', value: 65 },
          { day: 'Mar', value: 85 },
          { day: 'Mer', value: 45 },
          { day: 'Jeu', value: 95 },
          { day: 'Ven', value: 75 },
          { day: 'Sam', value: 35 },
          { day: 'Dim', value: 25 }
        ].map((item) => (
          <div key={item.day} class="flex-1 flex flex-col items-center gap-2 group">
            <div class="relative w-full">
              <div
                class="w-full bg-gradient-to-t from-blue-500 to-purple-500 rounded-t-xl group-hover:scale-y-110 transition-transform duration-300"
                style={{ height: `${item.value}px` }}
              ></div>
              <span class="absolute -top-6 left-1/2 -translate-x-1/2 opacity-0 group-hover:opacity-100 transition-opacity bg-white/20 backdrop-blur-xl px-2 py-1 rounded-lg text-xs text-white">
                {item.value} tâches
              </span>
            </div>
            <span class="text-white/60 text-xs">{item.day}</span>
          </div>
        ))}
      </div>
    </div>

    <!-- Rappels et événements -->
    <div class="bg-white/10 backdrop-blur-xl rounded-3xl border border-white/20 p-6">
      <h3 class="text-white font-semibold mb-4 flex items-center gap-2">
        <i class="fa-regular fa-bell text-yellow-400"></i>
        Rappels
      </h3>
      
      <div class="space-y-4">
        <div class="flex items-center gap-3 group hover:bg-white/5 p-2 rounded-xl transition-all">
          <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-yellow-500 to-orange-500 flex items-center justify-center shadow-lg group-hover:scale-110 transition-transform">
            <i class="fa-regular fa-clock text-white"></i>
          </div>
          <div class="flex-1 min-w-0">
            <p class="text-white font-medium truncate">Réunion d'équipe</p>
            <p class="text-white/60 text-sm">Dans 2 heures</p>
          </div>
        </div>
        
        <div class="flex items-center gap-3 group hover:bg-white/5 p-2 rounded-xl transition-all">
          <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-green-500 to-emerald-500 flex items-center justify-center shadow-lg group-hover:scale-110 transition-transform">
            <i class="fa-regular fa-file-lines text-white"></i>
          </div>
          <div class="flex-1 min-w-0">
            <p class="text-white font-medium truncate">Rapport mensuel</p>
            <p class="text-white/60 text-sm">Demain</p>
          </div>
        </div>
        
        <div class="flex items-center gap-3 group hover:bg-white/5 p-2 rounded-xl transition-all">
          <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-purple-500 to-pink-500 flex items-center justify-center shadow-lg group-hover:scale-110 transition-transform">
            <i class="fa-regular fa-star text-white"></i>
          </div>
          <div class="flex-1 min-w-0">
            <p class="text-white font-medium truncate">Revue de code</p>
            <p class="text-white/60 text-sm">Dans 3 jours</p>
          </div>
        </div>
      </div>

      <!-- Bouton voir tout -->
      <button class="w-full mt-6 py-2 border border-white/20 rounded-xl text-white/60 hover:text-white hover:bg-white/5 transition-all">
        Voir tous les rappels
      </button>
    </div>
  </div>
</DashboardLayout>