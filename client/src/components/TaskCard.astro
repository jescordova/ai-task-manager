---
// src/components/TaskCard.astro
export interface Props {
  title: string;
  description: string;
  priority: 'low' | 'medium' | 'high';
  dueDate: string;
  assignedTo?: string;
  tags?: string[];
  completed?: boolean;
}

const { title, description, priority, dueDate, assignedTo, tags = [], completed = false } = Astro.props;

const priorityColors = {
  low: 'bg-green-500/20 text-green-300 border-green-500/30',
  medium: 'bg-yellow-500/20 text-yellow-300 border-yellow-500/30',
  high: 'bg-red-500/20 text-red-300 border-red-500/30',
};

const priorityIcons = {
  low: 'fa-arrow-down',
  medium: 'fa-minus',
  high: 'fa-arrow-up',
};
---

<div class={`group relative bg-white/10 backdrop-blur-xl rounded-3xl border border-white/20 p-6 hover:shadow-2xl transition-all duration-500 hover:scale-[1.02] ${completed ? 'opacity-60' : ''}`}>
  <!-- Indicateur de priorité -->
  <div class={`absolute top-0 left-1/2 -translate-x-1/2 -translate-y-1/2 px-3 py-1 rounded-full text-xs font-medium border backdrop-blur-xl ${priorityColors[priority]} flex items-center gap-1`}>
    <i class={`fa-solid ${priorityIcons[priority]} text-xs`}></i>
    <span>Priorité {priority === 'high' ? 'haute' : priority === 'medium' ? 'moyenne' : 'basse'}</span>
  </div>

  <!-- Checkbox et titre -->
  <div class="flex items-start gap-3 mb-3">
    <div class="relative">
      <input
        type="checkbox"
        checked={completed}
        class="w-6 h-6 rounded-xl border-2 border-white/30 bg-white/5 checked:bg-gradient-to-r checked:from-green-500 checked:to-emerald-500 checked:border-transparent focus:ring-2 focus:ring-white/30 transition-all cursor-pointer"
      />
    </div>
    <div class="flex-1">
      <h3 class={`text-lg font-semibold text-white ${completed ? 'line-through text-white/50' : ''}`}>
        {title}
      </h3>
      <p class="text-white/60 text-sm mt-1">{description}</p>
    </div>
    <button class="text-white/40 hover:text-white transition-colors">
      <i class="fa-regular fa-star"></i>
    </button>
  </div>

  <!-- Tags -->
  {tags.length > 0 && (
    <div class="flex flex-wrap gap-2 my-4">
      {tags.map((tag) => (
        <span class="px-3 py-1 bg-white/5 rounded-full text-xs text-white/70 border border-white/20">
          #{tag}
        </span>
      ))}
    </div>
  )}

  <!-- Footer avec assignation et date -->
  <div class="flex items-center justify-between mt-4 pt-4 border-t border-white/20">
    <div class="flex items-center gap-2">
      <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-purple-500 to-pink-500 flex items-center justify-center text-white text-sm font-bold">
        {assignedTo ? assignedTo.charAt(0) : 'JD'}
      </div>
      <span class="text-white/60 text-sm">{assignedTo || 'Non assigné'}</span>
    </div>
    <div class="flex items-center gap-2 text-white/60">
      <i class="fa-regular fa-calendar"></i>
      <span class="text-sm">{dueDate}</span>
    </div>
  </div>

  <!-- Actions au survol -->
  <div class="absolute top-4 right-4 opacity-0 group-hover:opacity-100 transition-opacity flex gap-2">
    <button class="w-8 h-8 rounded-lg bg-white/10 hover:bg-white/20 text-white/60 hover:text-white transition-all">
      <i class="fa-regular fa-pen-to-square"></i>
    </button>
    <button class="w-8 h-8 rounded-lg bg-white/10 hover:bg-white/20 text-white/60 hover:text-white transition-all">
      <i class="fa-regular fa-trash-can"></i>
    </button>
  </div>
</div>