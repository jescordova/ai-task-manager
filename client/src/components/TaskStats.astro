---
// src/components/TaskStats.astro
const stats = [
  { label: 'Tâches totales', value: '48', icon: 'fa-list-check', color: 'blue', change: '+12%', trend: 'up' },
  { label: 'En cours', value: '23', icon: 'fa-spinner', color: 'yellow', change: '+5%', trend: 'up' },
  { label: 'Terminées', value: '19', icon: 'fa-circle-check', color: 'green', change: '+23%', trend: 'up' },
  { label: 'En retard', value: '6', icon: 'fa-clock', color: 'red', change: '-2%', trend: 'down' },
];

const getColorClasses = (color: string) => {
  const colors = {
    blue: 'from-blue-500 to-cyan-500 bg-blue-500/20 text-blue-300',
    yellow: 'from-yellow-500 to-orange-500 bg-yellow-500/20 text-yellow-300',
    green: 'from-green-500 to-emerald-500 bg-green-500/20 text-green-300',
    red: 'from-red-500 to-pink-500 bg-red-500/20 text-red-300',
  };
  return colors[color as keyof typeof colors];
};
---

<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
  {stats.map((stat) => (
    <div class="group relative overflow-hidden bg-white/10 backdrop-blur-xl rounded-3xl border border-white/20 p-6 hover:scale-105 transition-all duration-500">
      <!-- Effet de gradient animé -->
      <div class="absolute inset-0 bg-gradient-to-r opacity-0 group-hover:opacity-100 transition-opacity duration-500 from-white/0 via-white/5 to-white/0"></div>
      
      <div class="relative z-10">
        <div class="flex items-start justify-between mb-4">
          <div class={`w-14 h-14 rounded-2xl bg-gradient-to-br ${getColorClasses(stat.color)} flex items-center justify-center shadow-lg group-hover:scale-110 transition-transform duration-300`}>
            <i class={`fa-solid ${stat.icon} text-2xl text-white`}></i>
          </div>
          <span class={`px-2 py-1 rounded-full text-xs font-medium ${stat.trend === 'up' ? 'bg-green-500/20 text-green-300' : 'bg-red-500/20 text-red-300'}`}>
            {stat.change}
          </span>
        </div>
        
        <h3 class="text-4xl font-bold text-white mb-1">{stat.value}</h3>
        <p class="text-white/60 text-sm">{stat.label}</p>
      </div>

      <!-- Graphique sparkline animé -->
      <div class="absolute bottom-0 right-0 opacity-20 group-hover:opacity-30 transition-opacity">
        <svg width="80" height="40" viewBox="0 0 80 40" class="fill-current text-white">
          <path d="M0,40 L10,25 L20,35 L30,20 L40,30 L50,15 L60,25 L70,10 L80,20 L80,40 Z" />
        </svg>
      </div>
    </div>
  ))}
</div>