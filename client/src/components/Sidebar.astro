---
// src/components/Sidebar.astro
const menuItems = [
  { icon: 'fa-chart-pie', label: 'Tableau de bord', active: true, href: '#' },
  { icon: 'fa-list-check', label: 'Mes tâches', count: 12, href: '#' },
  { icon: 'fa-calendar', label: 'Calendrier', href: '#' },
  { icon: 'fa-users', label: 'Équipe', href: '#' },
  { icon: 'fa-chart-line', label: 'Analytiques', href: '#' },
  { icon: 'fa-gear', label: 'Paramètres', href: '#' },
];

// État initial (collapsed sur mobile, expanded sur desktop)
const isMobile = false; // Sera géré par JavaScript
---

<aside 
  class="sidebar h-svh bg-white/10 backdrop-blur-xl border-r border-white/20 flex flex-col sticky top-0 transition-all duration-300 ease-in-out"
  id="sidebar"
>
  <!-- En-tête du sidebar avec logo et bouton de toggle -->
  <div class="flex items-center justify-between p-4 md:p-6 border-b border-white/20">
    <!-- Logo - visible seulement quand expanded -->
    <div class="flex items-center gap-3 overflow-hidden transition-all duration-300 sidebar-expanded-content">
      <div class="w-10 h-10 md:w-12 md:h-12 flex-none bg-gradient-to-br from-blue-400 to-purple-600 rounded-2xl flex items-center justify-center shadow-lg hover:animate-float transition-all">
        <i class="fa-solid fa-bolt text-white text-lg md:text-xl"></i>
      </div>
      <div class="sidebar-expanded-only whitespace-nowrap">
        <h1 class="text-white font-bold text-base md:text-xl">TaskFlow</h1>
        <p class="text-white/60 text-xs">Dashboard v4</p>
      </div>
    </div>

    <!-- Bouton toggle pour mobile/tablet -->
    <button 
  class="toggle-sidebar w-8 h-8 md:w-10 md:h-10 flex-none bg-white/10 hover:bg-white/20 rounded-xl flex items-center justify-center text-white/60 hover:text-white transition-all"
  id="sidebarToggle"
  aria-label="Toggle sidebar"
>
  <i class="fa-solid fa-chevron-left text-sm md:text-base transition-transform duration-300" id="toggleIcon"></i>
</button>
  </div>

  <!-- Menu principal -->
  <nav class="flex-1 overflow-y-auto py-4 md:py-6 px-3 md:px-4 space-y-1">
    {menuItems.map((item) => (
      <a
        href={item.href}
        class={`flex items-center gap-3 px-3 md:px-4 py-2.5 md:py-3 rounded-xl md:rounded-2xl transition-all duration-300 group relative ${
          item.active
            ? 'bg-white/20 text-white shadow-lg'
            : 'text-white/60 hover:bg-white/10 hover:text-white'
        }`}
        title={item.label} // Tooltip pour la version icônes seulement
      >
        <!-- Icône avec taille adaptative -->
        <i class={`fa-solid ${item.icon} w-5 md:w-6 text-base md:text-lg flex-none ${item.active ? 'text-white' : 'group-hover:text-white'}`}></i>
        
        <!-- Label - caché quand sidebar collapsed -->
        <span class="sidebar-expanded-only flex-1 font-medium text-sm md:text-base truncate">{item.label}</span>
        
        <!-- Badge de compteur - adaptatif -->
        {item.count && (
          <span class={`
            flex-none px-1.5 md:px-2 py-0.5 md:py-1 bg-white/20 rounded-full text-[10px] md:text-xs font-bold text-white
            ${!item.active ? 'sidebar-expanded-only' : ''}
          `}>
            {item.count}
          </span>
        )}

        <!-- Tooltip pour la version mobile/icônes -->
        <span class="sidebar-collapsed-tooltip absolute left-full ml-2 px-2 py-1 bg-slate-900 text-white text-xs rounded-lg opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all whitespace-nowrap z-50">
          {item.label}
          {item.count && ` (${item.count})`}
        </span>
      </a>
    ))}
  </nav>

  <!-- Profil utilisateur -->
  <div class="mt-auto p-3 md:p-4 border-t border-white/20">
    <div class="flex items-center gap-3 p-2 md:p-3 bg-white/5 rounded-xl md:rounded-2xl hover:bg-white/10 transition-all duration-300 group relative">
      <div class="w-10 h-10 md:w-12 md:h-12 flex-none rounded-xl bg-gradient-to-br from-pink-500 to-orange-500 flex items-center justify-center shadow-lg">
        <span class="text-white font-bold text-sm md:text-lg">JD</span>
      </div>
      <div class="sidebar-expanded-only flex-1 min-w-0">
        <p class="text-white font-semibold text-sm md:text-base truncate">Jean Dupont</p>
        <p class="text-white/60 text-xs md:text-sm truncate">jean.d@taskflow.com</p>
      </div>
      <button class="sidebar-expanded-only text-white/60 hover:text-white transition-colors flex-none">
        <i class="fa-solid fa-ellipsis-vertical"></i>
      </button>

      <!-- Tooltip pour le profil en mode icônes -->
      <span class="sidebar-collapsed-tooltip absolute left-full ml-2 px-2 py-1 bg-slate-900 text-white text-xs rounded-lg opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all whitespace-nowrap z-50">
        Jean Dupont
      </span>
    </div>
  </div>
</aside>

<style>
  /* Styles pour le sidebar collapsed */
  .sidebar.collapsed {
    width: 80px !important;
  }

  .sidebar.collapsed .sidebar-expanded-only {
    opacity: 0;
    width: 0;
    margin-left: -8px;
    pointer-events: none;
  }

  .sidebar.collapsed .sidebar-expanded-content {
    justify-content: center;
  }

  .sidebar.collapsed nav a {
    justify-content: center;
    padding-left: 0;
    padding-right: 0;
  }

  .sidebar.collapsed nav a i {
    margin: 0 auto;
  }

  .sidebar:not(.collapsed) .sidebar-collapsed-tooltip {
    display: none;
  }

  /* Animation du bouton toggle */
  .sidebar.collapsed #toggleIcon {
    transform: rotate(180deg);
  }

  /* Adaptation mobile */
  @media (max-width: 768px) {
    .sidebar {
      position: fixed;
      left: 0;
      top: 0;
      bottom: 0;
      z-index: 50;
      box-shadow: 2px 0 10px rgba(0, 0, 0, 0.3);
    }

    .sidebar.collapsed {
      transform: translateX(-60px);
    }

    .sidebar.collapsed:hover {
      transform: translateX(0);
    }

    /* Overlay pour mobile quand sidebar est ouvert */
    .sidebar:not(.collapsed)::after {
      content: '';
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background: rgba(0, 0, 0, 0.5);
      backdrop-filter: blur(4px);
      z-index: -1;
      animation: fadeIn 0.3s ease-out;
    }
  }

  @keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }
</style>

<script>
  class SidebarManager {
    constructor() {
      this.sidebar = document.getElementById('sidebar');
      this.toggleBtn = document.getElementById('sidebarToggle');
      this.toggleIcon = document.getElementById('toggleIcon');
      this.isCollapsed = false;
      
      this.init();
    }

    init() {
      // Charger l'état depuis localStorage
      const savedState = localStorage.getItem('sidebarCollapsed');
      
      // Déterminer l'état initial basé sur la taille d'écran
      const isMobile = window.innerWidth <= 768;
      this.isCollapsed = savedState !== null ? savedState === 'true' : isMobile;
      
      this.applyState();
      this.setupEventListeners();
    }

    setupEventListeners() {
      // Toggle button click
      this.toggleBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        this.toggle();
      });

      // Responsive : ajuster quand la fenêtre est redimensionnée
      window.addEventListener('resize', () => {
        this.handleResize();
      });

      // Fermer le sidebar sur mobile quand on clique en dehors
      document.addEventListener('click', (e) => {
        if (window.innerWidth <= 768 && !this.isCollapsed && !this.sidebar.contains(e.target)) {
          this.collapse();
        }
      });
    }

    toggle() {
      this.isCollapsed = !this.isCollapsed;
      this.applyState();
      localStorage.setItem('sidebarCollapsed', this.isCollapsed);
    }

    collapse() {
      if (!this.isCollapsed) {
        this.isCollapsed = true;
        this.applyState();
        localStorage.setItem('sidebarCollapsed', this.isCollapsed);
      }
    }

    expand() {
      if (this.isCollapsed) {
        this.isCollapsed = false;
        this.applyState();
        localStorage.setItem('sidebarCollapsed', this.isCollapsed);
      }
    }

    handleResize() {
      const isMobile = window.innerWidth <= 768;
      const wasCollapsed = this.isCollapsed;
      
      // Sur mobile, on force le collapsed si pas déjà fait
      if (isMobile && !this.isCollapsed) {
        this.isCollapsed = true;
        this.applyState();
      } 
      // Sur desktop, on restaure l'état sauvegardé
      else if (!isMobile && wasCollapsed !== (localStorage.getItem('sidebarCollapsed') === 'true')) {
        const savedState = localStorage.getItem('sidebarCollapsed');
        this.isCollapsed = savedState === 'true';
        this.applyState();
      }
    }

    applyState() {
      if (this.isCollapsed) {
        this.sidebar.classList.add('collapsed');
        this.toggleIcon.style.transform = 'rotate(180deg)';
        document.documentElement.style.setProperty('--sidebar-width', '80px');
      } else {
        this.sidebar.classList.remove('collapsed');
        this.toggleIcon.style.transform = 'rotate(0deg)';
        document.documentElement.style.setProperty('--sidebar-width', '320px');
      }

      // Émettre un événement pour que d'autres composants puissent réagir
      window.dispatchEvent(new CustomEvent('sidebarToggle', { 
        detail: { collapsed: this.isCollapsed }
      }));
    }
  }

  // Initialiser quand le DOM est chargé
  document.addEventListener('DOMContentLoaded', () => {
    new SidebarManager();
  });
</script>